# neutron-switch-config.yaml.example
#
# Copy this file, fill in real switch management addresses and credentials,
# and apply it to the openstack namespace before running helm install.
#
#   apply:  oc apply -f neutron-switch-config.yaml -n openstack
#
# NEVER commit a copy of this file that contains real IP addresses or
# credentials.

apiVersion: v1
kind: Secret
metadata:
  name: neutron-switch-config
  namespace: openstack
stringData:
  03-ml2-genericswitch.conf: |
    [ngs]
    session_log_file = /var/log/neutron/ngs.log

    [genericswitch:dell-switch]
    device_type = netmiko_dell_force10
    ngs_mac_address = 68:4f:64:1d:01:d5
    ngs_save_configuration = True
    ngs_manage_vlans = false
    ngs_trunk_ports = <dell-uplink-port-name>
    ip = <dell-switch-management-ip>
    username = <admin-username>
    password = <admin-password>
    secret = <enable-secret>

    [genericswitch:MOC-DEV-SW1]
    device_type = netmiko_cumulus_nvue
    ngs_mac_address = b0:cf:0e:0f:b9:fd
    ngs_save_configuration = True
    ngs_manage_vlans = false
    ngs_trunk_ports = <cumulus-uplink-port-name>
    ip = <cumulus-switch-management-ip>
    username = <admin-username>
    password = <admin-password>
    secret = <admin-password>

type: Opaque
