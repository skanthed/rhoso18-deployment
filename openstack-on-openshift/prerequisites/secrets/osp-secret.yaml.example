# osp-secret.yaml.example
#
# Copy this file, replace every value with a real base64-encoded password,
# and apply it to the openstack namespace before running helm install.
#
#   base64 encoding:  echo -n 'YourPassword' | base64
#   apply:            oc apply -f osp-secret.yaml -n openstack
#
# NEVER commit a copy of this file that contains real passwords.

apiVersion: v1
kind: Secret
metadata:
  name: osp-secret
  namespace: openstack
type: Opaque
data:
  AdminPassword:                  <base64-encoded-password>
  AodhPassword:                   <base64-encoded-password>
  AodhDatabasePassword:           <base64-encoded-password>
  BarbicanDatabasePassword:       <base64-encoded-password>
  BarbicanPassword:               <base64-encoded-password>
  BarbicanSimpleCryptoKEK:        <base64-encoded-key>
  CeilometerPassword:             <base64-encoded-password>
  CinderDatabasePassword:         <base64-encoded-password>
  CinderPassword:                 <base64-encoded-password>
  DatabasePassword:               <base64-encoded-password>
  DbRootPassword:                 <base64-encoded-password>
  DesignateDatabasePassword:      <base64-encoded-password>
  DesignatePassword:              <base64-encoded-password>
  GlanceDatabasePassword:         <base64-encoded-password>
  GlancePassword:                 <base64-encoded-password>
  HeatAuthEncryptionKey:          <base64-encoded-key>
  HeatDatabasePassword:           <base64-encoded-password>
  HeatPassword:                   <base64-encoded-password>
  IronicDatabasePassword:         <base64-encoded-password>
  IronicInspectorDatabasePassword: <base64-encoded-password>
  IronicInspectorPassword:        <base64-encoded-password>
  IronicPassword:                 <base64-encoded-password>
  KeystoneDatabasePassword:       <base64-encoded-password>
  ManilaDatabasePassword:         <base64-encoded-password>
  ManilaPassword:                 <base64-encoded-password>
  MetadataSecret:                 <base64-encoded-secret>
  NeutronDatabasePassword:        <base64-encoded-password>
  NeutronPassword:                <base64-encoded-password>
  NovaAPIDatabasePassword:        <base64-encoded-password>
  NovaAPIMessageBusPassword:      <base64-encoded-password>
  NovaCell0DatabasePassword:      <base64-encoded-password>
  NovaCell0MessageBusPassword:    <base64-encoded-password>
  NovaCell1DatabasePassword:      <base64-encoded-password>
  NovaCell1MessageBusPassword:    <base64-encoded-password>
  NovaPassword:                   <base64-encoded-password>
  OctaviaDatabasePassword:        <base64-encoded-password>
  OctaviaPassword:                <base64-encoded-password>
  PlacementDatabasePassword:      <base64-encoded-password>
  PlacementPassword:              <base64-encoded-password>
  SwiftPassword:                  <base64-encoded-password>
